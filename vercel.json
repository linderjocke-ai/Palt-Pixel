{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(img|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/projects.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mateo-api/(.*)",
      "destination": "https://meny-api.mateo.se/api/v1/$1"
    }
  ],
  "redirects": [
    {
      "source": "/mattetraning",
      "destination": "/matte/",
      "permanent": false
    },
    {
      "source": "/matteträning",
      "destination": "/matte/",
      "permanent": false
    },
    {
      "source": "/frontlinje",
      "destination": "/frontlinjen/",
      "permanent": false
    },
    {
      "source": "/projekt/frontlinjen",
      "destination": "/frontlinjen/",
      "permanent": false
    },
    {
      "source": "/projekt/veckopalten",
      "destination": "/veckopalten/",
      "permanent": false
    },
    {
      "source": "/projekt/matte",
      "destination": "/matte/",
      "permanent": false
    },
    {
      "source": "/mattetraning/",
      "destination": "/matte/",
      "permanent": false
    },
    {
      "source": "/matteträning/",
      "destination": "/matte/",
      "permanent": false
    },
    {
      "source": "/frontlinje/",
      "destination": "/frontlinjen/",
      "permanent": false
    },
    {
      "source": "/projekt/frontlinjen/",
      "destination": "/frontlinjen/",
      "permanent": false
    },
    {
      "source": "/projekt/veckopalten/",
      "destination": "/veckopalten/",
      "permanent": false
    },
    {
      "source": "/projekt/matte/",
      "destination": "/matte/",
      "permanent": false
    }
  ]
}